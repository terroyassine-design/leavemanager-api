# Copy to .env (never commit .env) or set these variables on the hosting platform.

# "prod" enables production safety checks (the app refuses to start with the default JWT secret)
SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://localhost:5432/leavemanager
DATABASE_USERNAME=leavemanager
DATABASE_PASSWORD=leavemanager

# At least 32 random characters, e.g. generated with: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string-of-32-chars-or-more
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_DATA_ENABLED=true
